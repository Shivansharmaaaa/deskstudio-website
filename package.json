{
  "name": "deskstudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "studio": "remotion studio remotion/index.js",
    "video": "remotion render remotion/index.js PencilLine out/pencil.mp4",
    "reel": "remotion render remotion/index.js Reel out/deskstudio-reel.mp4",
    "render:frames": "remotion render remotion/index.js PencilLine out/frames --sequence --image-format=png",
    "frames": "npm run render:frames && node scripts/frames-to-public.mjs out/frames",
    "pin:auth": "node scripts/pinterest/auth.mjs url",
    "pin:token": "node scripts/pinterest/auth.mjs token",
    "pin:boards": "node scripts/pinterest/fetch-board.mjs boards",
    "pin:fetch": "node scripts/pinterest/fetch-board.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.477",
    "@remotion/transitions": "^4.0.477",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  }
}
